{
  "name": "ai-telemetry-toolkit",
  "version": "0.1.0",
  "description": "AI-powered performance telemetry toolkit for developers — MCP + OpenTelemetry + AI agents",
  "type": "module",
  "bin": {
    "ai-telemetry-toolkit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-telemetry-toolkit/core": "workspace:*",
    "@ai-telemetry-toolkit/otel": "workspace:*",
    "@ai-telemetry-toolkit/agents": "workspace:*",
    "@ai-telemetry-toolkit/reporters": "workspace:*",
    "@ai-telemetry-toolkit/mcp-server": "workspace:*",
    "commander": "^12.0.0",
    "inquirer": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "opentelemetry",
    "mcp",
    "ai-agent",
    "performance",
    "telemetry",
    "claude-code",
    "developer-tools"
  ],
  "license": "MIT"
}
